# Discord bot token. Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=

# Only used when github.auth = "token".
# Fine-grained token: Issues read/write + Metadata read, scoped to IntelOrca/arklay-rs.
GITHUB_TOKEN=

# Optional user token for uploading screenshots/save files to GitHub.
# Fine-grained token with Contents: Read and write, scoped to the attachment
# repository (recommended) or to arklay-rs for the user-attachments fallback.
GITHUB_ATTACHMENT_TOKEN=

# Only needed when llm.backend = "openai".
OPENCODE_API_KEY=

# Optional: set to "debug" for more logs.
LOG_LEVEL=info
